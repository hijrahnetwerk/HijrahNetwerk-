{
  "name": "hijrah-netwerk",
  "version": "2.0.0",
  "private": true,
  "description": "Hijrah Netwerk — Next.js platform",
  "scripts": {
    "dev": "next dev",
    "build": "npm run prepare:legacy && next build",
    "start": "next start",
    "cf:build": "npm run prepare:legacy && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "prepare:legacy": "node scripts/prepare-legacy.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.9",
    "wrangler": "4.148.0"
  }
}
